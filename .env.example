NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL publique du site (sitemap)
NEXT_PUBLIC_SITE_URL=https://afridevhub.vercel.app

# Liens de téléchargement (laisser vide tant que le binaire n'est pas publié)
NEXT_PUBLIC_DL_ANDROID=
NEXT_PUBLIC_DL_IOS=
NEXT_PUBLIC_DL_WINDOWS=
NEXT_PUBLIC_DL_MACOS=
NEXT_PUBLIC_DL_LINUX=

# Mentions légales
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Mise à jour des applications (/api/version)
LATEST_VERSION=
MIN_VERSION=
RELEASE_NOTES=
# Liens directs de mise à jour des applications (https). Android : l'APK ; Windows : l'installateur .exe.
DL_ANDROID=
DL_WINDOWS=
DL_MACOS=
DL_IOS=
DL_LINUX=

# Web Push (site fermé) : clé publique VAPID (npx web-push generate-vapid-keys). La clé privée va dans les secrets Supabase.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
